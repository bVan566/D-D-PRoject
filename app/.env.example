# Copy this file to .env and fill in your own key. .env is git-ignored -- it will
# never be committed, logged, or included in anything this project publishes.
#
# Get a key at https://console.anthropic.com (API/developer console -- this is a
# separate account from a claude.ai chat subscription, and is billed separately,
# by usage).

# Required for live DM / Companion / Lore replies and the auto-review learning loop.
# Everything else in this app (character sheets, dice, combat tracker, save/resume,
# quests, lore log, world-building notes) works fully without this set.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5 if unset.
# DUO_ENGINE_MODEL=claude-sonnet-5

# Optional. Rough $ per million tokens, used only to estimate cost on the Usage panel.
# Check https://console.anthropic.com/settings/billing for current rates -- these are
# not fetched live, just a local estimate so you can watch spend during testing.
# DUO_ENGINE_INPUT_PRICE_PER_MTOK=3
# DUO_ENGINE_OUTPUT_PRICE_PER_MTOK=15

# Optional. Local server port.
# PORT=4173
