<%- include('partials/head', { title: 'Add Companion' }) %>
<%- include('partials/nav', { campaignId: campaign.campaign_id, role: 'dm', active: null }) %>

<h1>Add an AI Companion &mdash; <%= campaign.campaign_title %></h1>
<p class="subtitle">This character is played by its own Player Agent as an independent party member, not an NPC or
  DM helper. Give it real motives and a private fear &mdash; those fields are structurally withheld from the DM view
  and every other party member's view; only this companion's own seat and Lore can see them. You can add more than
  one companion, and add more later from the Party page.</p>

<form method="post" action="/campaigns/<%= campaign.campaign_id %>/characters/companion/new">
  <div class="card">
    <h2 style="margin-top:0">Identity</h2>
    <div class="grid cols-2">
      <label>Name<input name="name" required placeholder="Mira Vey" /></label>
      <% if (typeof characterOptions !== 'undefined' && characterOptions) { %>
        <label>Race<select id="race-select" name="race_id"></select></label>
        <label>Class<select id="class-select" name="class_id"></select></label>
        <input type="hidden" name="species" id="species-hidden" />
        <input type="hidden" name="class_level" id="class-level-hidden" />
      <% } else { %>
        <label>Species<input name="species" placeholder="Human" /></label>
        <label>Class &amp; level<input name="class_level" placeholder="Rogue 4" /></label>
      <% } %>
      <label>Background<input name="background" placeholder="Courier / former border runner" /></label>
      <label>Alignment<input name="alignment" placeholder="Neutral Good" /></label>
      <label>Starting <%= typeof currencyLabel !== 'undefined' ? currencyLabel : 'gold' %><input name="gp" type="number" value="20" /></label>
    </div>
    <% if (typeof characterOptions !== 'undefined' && characterOptions) { %>
      <p class="hint" id="race-traits"></p>
      <p class="hint" id="class-info"></p>
    <% } %>
  </div>

  <% if (typeof characterOptions !== 'undefined' && characterOptions) { %>
    <div class="card">
      <h2 style="margin-top:0">Starting Equipment Kit</h2>
      <p class="hint">Picking a kit fills in inventory and a suggested Armor Class below &mdash; both stay editable.</p>
      <div id="kit-options"></div>
    </div>

    <div class="card">
      <h2 style="margin-top:0">Skill Proficiencies <span class="hint" id="skill-count-hint"></span></h2>
      <div id="skill-checkboxes"></div>
    </div>
  <% } %>

  <div class="card">
    <h2 style="margin-top:0">Abilities</h2>
    <% if (typeof characterOptions !== 'undefined' && characterOptions) { %>
      <button type="button" id="roll-btn" class="secondary">Roll Ability Scores (4d6, drop lowest)</button>
      <div id="roll-pool"></div>
      <p class="hint" style="margin-top:14px"><strong>Final scores</strong> (rolled value + racial bonus &mdash; these are what get saved):</p>
    <% } %>
    <div class="grid cols-3">
      <label><%= (abilityLabels && abilityLabels.str) || 'STR' %><input name="str" type="number" value="10" /></label>
      <label><%= (abilityLabels && abilityLabels.dex) || 'DEX' %><input name="dex" type="number" value="10" /></label>
      <label><%= (abilityLabels && abilityLabels.con) || 'CON' %><input name="con" type="number" value="10" /></label>
      <label><%= (abilityLabels && abilityLabels.int) || 'INT' %><input name="int" type="number" value="10" /></label>
      <label><%= (abilityLabels && abilityLabels.wis) || 'WIS' %><input name="wis" type="number" value="10" /></label>
      <label><%= (abilityLabels && abilityLabels.cha) || 'CHA' %><input name="cha" type="number" value="10" /></label>
    </div>
    <% if (typeof characterOptions !== 'undefined' && characterOptions) { %>
      <p class="hint">Race ability bonuses are applied automatically once you pick a race above.</p>
    <% } %>
  </div>

  <div class="card">
    <h2 style="margin-top:0">Combat basics</h2>
    <div class="grid cols-3">
      <label>Armor Class<input name="ac" type="number" value="12" /></label>
      <label>Max HP<input name="hp_max" type="number" value="10" /></label>
      <label>Speed<input name="speed" type="number" value="30" /></label>
    </div>
    <label>Inventory (one item per line)</label>
    <textarea name="inventory" placeholder="shortbow&#10;shortsword&#10;daggers&#10;thieves' tools"></textarea>
  </div>

  <div class="card">
    <h2 style="margin-top:0">Personality &amp; public goals <span class="badge public">public</span></h2>
    <div class="grid cols-2">
      <label>Traits<textarea name="traits" placeholder="Observant, dryly funny, suspicious of institutional authority"></textarea></label>
      <label>Ideals<textarea name="ideals"></textarea></label>
      <label>Bonds<textarea name="bonds"></textarea></label>
      <label>Flaws<textarea name="flaws"></textarea></label>
    </div>
    <label>Stated public goals (one per line)</label>
    <textarea name="goals_public" placeholder="Complete the escort contract and get paid"></textarea>
  </div>

  <div class="card">
    <h2 style="margin-top:0">Private character state <span class="badge companion_pc">companion_pc</span> <span class="badge lore_only">lore_only</span></h2>
    <p class="hint">These drive independent decisions without becoming world truth or being revealed to the DM/human
      until the companion legitimately chooses to share them in play.</p>
    <label>Private beliefs / motives (one per line)</label>
    <textarea name="private_beliefs" placeholder="Wants reliable travel papers through the region"></textarea>
    <label>Private fears (one per line)</label>
    <textarea name="private_fears" placeholder="Being trapped into service she cannot walk away from"></textarea>
    <label>Private personal goals (one per line)</label>
    <textarea name="private_goals"></textarea>
    <label>Tactical / behavioral preferences (one per line)</label>
    <textarea name="tactical_preferences" placeholder="Use cover, avoid melee when possible, protect escape routes"></textarea>
  </div>

  <div class="btn-row">
    <button type="submit">Add to Party &rarr;</button>
  </div>
</form>

<% if (typeof characterOptions !== 'undefined' && characterOptions) { %>
  <script>
    window.CHARACTER_OPTIONS = <%- JSON.stringify(characterOptions).replace(/</g, '\\u003c') %>;
    window.ABILITY_LABELS = <%- JSON.stringify(abilityLabels || {}).replace(/</g, '\\u003c') %>;
  </script>
  <script src="/js/character-creator.js"></script>
<% } %>

<%- include('partials/foot') %>
