<%- include('partials/head', { title: 'World Building' }) %>
<%- include('partials/nav', { campaignId, role, active: 'worldbuilding' }) %>

<h1>World Building</h1>
<p class="subtitle">Out-of-character. This is a separate job from Lore's in-session role: here the collaborator is
  meant to propose and riff, not just record. Nothing said below is canon until you explicitly commit it.</p>

<% if (role === 'human') { %>
  <div class="banner">Heads up: this is normally DM-side prep work. Brainstorming here as yourself may reveal your
    own future secrets before Dhovir discovers them in play. If you want the DM to be able to surprise you, do this
    from the DM tab instead — nothing stops you either way, it's your call.</div>
<% } %>

<div class="two-col">
  <div class="card">
    <div class="chat-log">
      <% if (!log.length) { %><p class="empty">No brainstorming yet — say hello below.</p><% } %>
      <% log.forEach(m => { %>
        <div class="chat-msg role-<%= m.role === 'worldbuilder' ? 'lore' : m.role %>">
          <div class="who"><%= m.speaker_name %> <span class="hint" style="margin-left:auto"><%= new Date(m.timestamp).toLocaleTimeString() %></span></div>
          <div class="content"><%= m.content %></div>
        </div>
      <% }) %>
    </div>

    <form method="post" action="/campaigns/<%= campaignId %>/worldbuilding/message" style="margin-top:14px">
      <input type="hidden" name="role" value="<%= role %>" />
      <label>Speaking as</label>
      <input name="speaker_name" value="<%= role === 'dm' ? 'DM (prep)' : role === 'lore' ? 'Lore (audit)' : 'Me' %>" />
      <label>Message</label>
      <textarea name="content" placeholder="What if the sealed chamber was originally a prison, not a shrine?"></textarea>
      <% if (llmConfigured) { %>
        <label><input type="checkbox" name="ask_worldbuilder" style="width:auto;display:inline-block" /> Ask the world-building collaborator to riff on this</label>
      <% } %>
      <div class="btn-row"><button type="submit">Send</button></div>
    </form>
    <% if (!llmConfigured) { %>
      <p class="hint">Live collaborator replies need <code>ANTHROPIC_API_KEY</code>. You can still use this as a
        scratchpad and commit ideas straight to canon below.</p>
    <% } %>
  </div>

  <div>
    <div class="card">
      <h3>Commit to Canon</h3>
      <p class="hint">The only way anything here becomes real. Goes through the exact same canon record as the Lore
        page — same visibility rules apply from this point on.</p>
      <form method="post" action="/campaigns/<%= campaignId %>/worldbuilding/commit">
        <input type="hidden" name="role" value="<%= role %>" />
        <label>Statement</label>
        <textarea name="statement" required placeholder="The sealed chamber was built as a prison for something, not a shrine."></textarea>
        <div class="grid cols-2">
          <label>Canon status
            <select name="canon_status">
              <option value="open_lore" selected>open_lore</option>
              <option value="locked_canon">locked_canon</option>
              <option value="dm_truth">dm_truth</option>
              <option value="unresolved_space">unresolved_space</option>
            </select>
          </label>
          <label>Visibility
            <select name="visibility">
              <option value="public">public</option>
              <option value="dm_private" selected>dm_private</option>
              <option value="lore_only">lore_only</option>
            </select>
          </label>
        </div>
        <button type="submit">Commit</button>
      </form>
    </div>

    <div class="card">
      <h3>Committed So Far</h3>
      <ul class="clean">
        <% canon.slice(-8).reverse().forEach(f => { %>
          <li><span class="badge <%= f.canon_status %>"><%= f.canon_status %></span> <span class="badge <%= f.visibility %>"><%= f.visibility %></span> <%= f.statement %></li>
        <% }) %>
        <% if (!canon.length) { %><li class="empty">Nothing committed yet.</li><% } %>
      </ul>
      <a href="/campaigns/<%= campaignId %>/lore?role=<%= role %>">Full canon record &rarr;</a>
    </div>
  </div>
</div>

<%- include('partials/foot') %>
